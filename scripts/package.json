{
  "name": "sui-cctp",
  "version": "1.0.0",
  "description": "Circle's CCTP Smart Contracts on Sui blockchain",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/circlefin/sui-cctp.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "deploy": "node --import tsx --require dotenv/config 'sui/deploy.ts'",
    "deploy-local:v1": "FULLNODE_PORT=9001 FAUCET_PORT=9123 LINK_EVM_CONTRACTS=true yarn deploy --deploy-version 1",
    "deploy-local:v2": "FULLNODE_PORT=9001 FAUCET_PORT=9123 LINK_EVM_CONTRACTS=false yarn deploy --deploy-version 2",
    "deploy-skip-linking-local:v1": "FULLNODE_PORT=9001 FAUCET_PORT=9123 LINK_EVM_CONTRACTS=false yarn deploy --deploy-version 1",
    "deploy-remote:v2": "node --import tsx 'sui/deploy.ts' --deploy-version 2",
    "test": "NODE_OPTIONS=--experimental-vm-modules yarn jest --runInBand",
    "test-local": "FULLNODE_PORT=9001 FAUCET_PORT=9123 NODE_OPTIONS=--experimental-vm-modules yarn jest --runInBand",
    "test-local:v1": "FULLNODE_PORT=9001 FAUCET_PORT=9123 NODE_OPTIONS=--experimental-vm-modules yarn jest --runInBand test/e2e.test.ts",
    "test-local:v2": "FULLNODE_PORT=9001 FAUCET_PORT=9123 NODE_OPTIONS=--experimental-vm-modules yarn jest --runInBand test/txAdapter.test.ts test/messageV2.test.ts test/executeTransactionWithRetry.test.ts test/e2e.v2.test.ts test/upgrade.e2e.v2.test.ts",
    "deposit-for-burn-example:v1": "node --import tsx --require dotenv/config 'sui/depositForBurn.ts'",
    "receive-message-example:v1": "node --import tsx --require dotenv/config 'sui/receiveMessage.ts'",
    "deposit-for-burn-example:v2": "node --import tsx --require dotenv/config 'sui/depositForBurnV2.ts'",
    "receive-message-example:v2": "node --import tsx --require dotenv/config 'sui/receiveMessageV2.ts'",
    "upgrade:deposit-cap": "node --import tsx --require dotenv/config 'sui/upgrade/depositUpgradeCap.ts'",
    "upgrade:package": "node --import tsx --require dotenv/config 'sui/upgrade/upgrade.ts'",
    "upgrade:migrate": "node --import tsx --require dotenv/config 'sui/upgrade/upgradeMigration.ts'",
    "upgrade:v2": "node --import tsx --require dotenv/config 'sui/upgrade/migrate.ts'"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.7.0",
    "@jest/globals": "^29.7.0",
    "@mysten/sui": "2.22.1",
    "@types/chai": "^4.3.16",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.13",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.17.0",
    "chai": "^5.1.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.8.0",
    "ethereumjs-util": "^7.1.5",
    "globals": "^15.8.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lodash": "^4.17.21",
    "mocha": "^10.4.0",
    "prettier": "^3.2.5",
    "prettier-eslint": "^16.3.0",
    "ts-jest": "^29.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "wait-for-expect": "^3.0.2",
    "web3": "^4.11.1",
    "yup": "^1.4.0"
  },
  "engines": {
    "node": "20.14.0"
  },
  "packageManager": "yarn@3.2.2",
  "resolutions": {
    "cipher-base": "1.0.5",
    "pbkdf2": "3.1.3",
    "sha.js": "2.4.12"
  }
}
