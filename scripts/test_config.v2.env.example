##################################
# Sui V2 Contract Configurations #
##################################

# The below environment variables are produced by the V2 deploy flow.
# Running `yarn deploy-local:v2` (or `--deploy-version 2`) produces a
# `test_config.v2.env` file, automatically filling all values from deployment
# output. V1 and V2 deploy separately: `--deploy-version` accepts only "1" or
# "2" and throws otherwise (`resolveDeployVersion`, deploy.ts), so there is no
# combined output file.
SUI_CCTP_EXTENSIONS_ID=
SUI_MESSAGE_TRANSMITTER_V2_ID=
SUI_MESSAGE_TRANSMITTER_V2_STATE_ID=
SUI_MESSAGE_TRANSMITTER_V2_UPGRADE_SERVICE_ID=
SUI_TOKEN_MESSENGER_MINTER_V2_ID=
SUI_TOKEN_MESSENGER_MINTER_V2_STATE_ID=
SUI_TOKEN_MESSENGER_MINTER_V2_UPGRADE_SERVICE_ID=
SUI_STABLECOIN_HANDLER_ID=
SUI_STABLECOIN_HANDLER_STATE_ID=
SUI_STABLECOIN_HANDLER_UPGRADE_SERVICE_ID=
SUI_MINT_CAP_V2_ID=
SUI_USDC_TOKEN_ID_V2=
SUI_USDC_FUNDS_V2_OBJECT_ID=
SUI_ATTESTER_ADDRESS=
SUI_FEE_RECIPIENT_ADDRESS=
SUI_USDC_ID=
SUI_TREASURY_ID=
SUI_EXTENSIONS_ID=
SUI_STABLECOIN_ID=
SUI_DEPLOYER_KEY=

##########################################
# Public Network Configuration (V2)      #
##########################################

# Only needed to run the V2 example scripts against a public network
# (testnet/mainnet). A localnet run leaves this whole section unset —
# `yarn deploy-local:v2` fills in everything the examples need.
#
# Unlike the keys above, these are not produced by a deploy you ran: a public
# network run targets contracts that someone else already deployed, so the ids
# in the block above must be filled in by hand from that deployment's record.
#
# The V2 deposit-for-burn example reads exactly these ids from the block above:
#
#   SUI_TOKEN_MESSENGER_MINTER_V2_ID        package for deposit_for_burn/complete_burn
#   SUI_TOKEN_MESSENGER_MINTER_V2_STATE_ID  TokenMessengerMinter State
#   SUI_MESSAGE_TRANSMITTER_V2_STATE_ID     MessageTransmitter State
#   SUI_STABLECOIN_HANDLER_ID               package for handler::burn
#   SUI_STABLECOIN_HANDLER_STATE_ID         StablecoinHandler State
#   SUI_TREASURY_ID                         Treasury<USDC>
#   SUI_USDC_ID                             USDC package (the coin type)
#   SUI_MESSAGE_TRANSMITTER_V2_ID           required by the config loader, but
#                                           not used by the burn itself
#
# Every other key in the block above may be left blank for an example-script
# run. DenyList (0x403) and Clock (0x6) are Sui system objects and need no
# configuration on any network.

# Target network: localnet, testnet, or mainnet.
SUI_NETWORK=

# Fullnode RPC url. Required for testnet/mainnet; a localnet run defaults to
# http://localhost:${FULLNODE_PORT:-9001}.
SUI_RPC_URL=

# Signing key for the example scripts, in `suiprivkey1...` form. This is the
# address that burns the USDC, and on a public network it is the caller's own
# funded address rather than the deployer of the target contracts. Falls back to
# SUI_DEPLOYER_KEY above when unset, which is what a localnet run uses.
SUI_SIGNER_KEY=
