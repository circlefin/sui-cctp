# Config for a real-network (testnet / mainnet) CCTP V2 publish.
#
# Copy to deploy.<name>.env and fill in. These files are gitignored: each
# describes a separate deployment, and one may optionally carry a deployer key.
#
#   yarn deploy-remote:v2 --config deploy.<name>.env
#
# Multiple deployments may target the same Sui network; they differ only by RPC
# and by which record files they produce.
#
# Precedence: a real environment variable beats this file, and this file beats
# scripts/.env. (`.env.example` ships an empty DEPLOYER_PRIVATE_KEY=, and dotenv
# treats a present-but-empty key as set — hence the explicit ordering.)

# Target network. One of: testnet, mainnet.
SUI_NETWORK=testnet

# Full node RPC for the target network. Must match the `sui` CLI env of the same
# alias — the publish builds against the active client env.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Deployer. The publish is signed by `sui client publish` using the CLI's active
# address, so this process never signs anything — prefer leaving the key in the
# Sui keystore and naming the address here. A key is never generated for a real
# network.
#
# Must already be funded: a full four-package publish measured ~0.44 SUI, and
# the deploy refuses to start below 0.75 SUI.
DEPLOYER_ADDRESS=

# Optional, for automation that has to supply a key (suiprivkey1...). If set it
# is imported into the keystore; otherwise DEPLOYER_ADDRESS must already be
# there. Leaving this blank keeps the key out of the config file entirely.
DEPLOYER_PRIVATE_KEY=

# Where to write the deployment record. Defaults to deploy.<network>.env; set it
# explicitly so two testnet deploys don't overwrite each other's record.
DEPLOY_OUTPUT=deploy.<name>.out.env
